{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Circle Taiwan landmark catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "crs",
    "projection",
    "landmarks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^landmarks-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{2,}$"
    },
    "crs": {
      "const": "EPSG:3826"
    },
    "projection": {
      "type": "string",
      "minLength": 1
    },
    "landmarks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/landmark"
      }
    }
  },
  "$defs": {
    "wgs84": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "items": false
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetUrl",
        "recordId",
        "licenseUrl",
        "retrievedAt",
        "snapshotSha256"
      ],
      "properties": {
        "datasetUrl": {
          "type": "string",
          "format": "uri"
        },
        "recordId": {
          "type": "string",
          "minLength": 1
        },
        "licenseUrl": {
          "type": "string",
          "format": "uri"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "snapshotSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "landmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "county",
        "anchorLabel",
        "wgs84",
        "point",
        "source",
        "reviewedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^lm-[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 40
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "county": {
          "type": "string",
          "pattern": "^[0-9]{5}$"
        },
        "anchorLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "wgs84": {
          "$ref": "#/$defs/wgs84"
        },
        "point": {
          "$ref": "#/$defs/point"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
